{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nfl",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // The workers.dev URL stays live alongside the custom domain so older links keep working.
  "workers_dev": true,
  "routes": [{ "pattern": "playtally.app", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The Worker decides what every page route is: Tally's own tags at /, the pool's at /p/*,
    // and a redirect for the root-level paths the pool used to live at.
    "run_worker_first": ["/api/*", "/", "/p/*", "/welcome", "/rules", "/week/*", "/board", "/board/*", "/admin", "/.well-known/*", "/apple-app-site-association"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nfl-pool",
      "database_id": "fcf49496-249e-4f76-a623-efe9b0c7e6a8",
      "migrations_dir": "migrations"
    }
  ],
  // Two expressions, because the free plan allows five per *account* and this is not the only
  // Worker on it. The first is the daily schedule sync. The second sweeps for finished games every
  // half hour through the windows games actually end in, in UTC: Sunday afternoon and evening,
  // plus the small hours that are Sunday, Monday and Thursday night in America. The window is
  // deliberately wide so it still covers the game times after the clocks change in November, and
  // a firing with nothing to do never leaves the database.
  "triggers": { "crons": ["0 10 * * *", "*/30 19-23,0-5 * * 0,1,2,5"] },
  "vars": {
    "ENVIRONMENT": "production",
    // The app is Tally; this pool is one instance of the High Five pool type. POOL_SLUG is the
    // path it lives at — playtally.app/p/high-five — and POOL_NAME is what players see.
    "APP_NAME": "Tally",
    "POOL_TYPE": "High Five",
    "POOL_SLUG": "high-five",
    "POOL_NAME": "High Five",
    // The iOS app, as Apple knows it: <team id>.<bundle id>, comma-separated if there is more than
    // one (a TestFlight build and a release build share an id; a second app would not). Empty
    // until the app exists in App Store Connect; see ios/README.md.
    "APPLE_APP_IDS": ""
  },
  "observability": { "enabled": true }
}
