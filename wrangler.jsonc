{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nfl",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // The workers.dev URL stays live alongside the custom domain so older links keep working.
  "workers_dev": true,
  "routes": [{ "pattern": "playtally.app", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The Worker decides what every page route is: Tally's own tags at /, the pool's at /p/*,
    // and a redirect for the root-level paths the pool used to live at.
    "run_worker_first": ["/api/*", "/", "/p/*", "/welcome", "/rules", "/week/*", "/board", "/board/*", "/admin", "/.well-known/*", "/apple-app-site-association"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nfl-pool",
      "database_id": "fcf49496-249e-4f76-a623-efe9b0c7e6a8",
      "migrations_dir": "migrations"
    }
  ],
  // Two expressions, because the free plan allows five per *account* and this is not the only
  // Worker on it. The first is the daily schedule sync. The second sweeps for finished games and
  // sends notifications, every half hour, always. It used to be narrowed to the UTC windows games
  // end in, but the league keeps finding new ones — a Friday game in Brazil, a Wednesday at
  // Christmas, a 9:30am kickoff in London — and a notification that never fires is a worse bug
  // than a cron that finds nothing. It costs nothing to be wrong about the quiet hours: with no
  // unfinished game to look up, the sweep never fetches the feed, and with nothing new settled
  // there is nothing to say.
  "triggers": { "crons": ["0 10 * * *", "*/30 * * * *"] },
  "vars": {
    "ENVIRONMENT": "production",
    // The app is Tally; this pool is one instance of the High Five pool type. POOL_SLUG is the
    // path it lives at — playtally.app/p/high-five — and POOL_NAME is what players see.
    "APP_NAME": "Tally",
    "POOL_TYPE": "High Five",
    "POOL_SLUG": "high-five",
    "POOL_NAME": "High Five",
    // The iOS app, as Apple knows it: <team id>.<bundle id>, comma-separated if there is more than
    // one (a TestFlight build and a release build share an id; a second app would not). Empty
    // until the app exists in App Store Connect; see ios/README.md.
    "APPLE_APP_IDS": "8445LWRG3B.app.playtally.ios",
    // The App Store listing id (digits only, from the app's App Store URL). Setting it turns on
    // Safari's "Open in the app" banner on the website. Empty until the app is listed.
    "APPLE_APP_STORE_ID": "",
    // Push notifications. These three are public — the team id appears in the file Apple fetches
    // from this domain, and the bundle id is on the App Store — so they belong here. The key
    // itself does not: `wrangler secret put APNS_KEY`, pasting in the .p8. Until that secret is
    // set the worker registers device tokens and sends nothing, which is the right behaviour for
    // anyone running this without an Apple developer account.
    "APPLE_TEAM_ID": "8445LWRG3B",
    "APPLE_BUNDLE_ID": "app.playtally.ios",
    // The 10-character id of the APNs key, shown next to it in the developer portal. Not a secret
    // (it travels in the header of every push), but useless without the key.
    "APNS_KEY_ID": ""
  },
  "observability": { "enabled": true }
}
