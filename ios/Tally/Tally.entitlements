<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Both halves of one story: webcredentials lets the app use the passkeys made on
	     playtally.app (and vice versa); applinks opens pool links in the app. The domain has to
	     name this app back in /.well-known/apple-app-site-association (worker/apple.ts). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:playtally.app</string>
		<string>applinks:playtally.app</string>
	</array>
	<!-- Push notifications. "development" is what a build signed by Xcode needs; Xcode rewrites it
	     to "production" when the app is archived for TestFlight or the App Store, so this value is
	     correct in the repository and correct in a release. Adding this capability is also what
	     tells Xcode to enable Push Notifications on the App ID when it provisions, which is why
	     there is nothing to do in the developer portal beyond minting the key itself. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
