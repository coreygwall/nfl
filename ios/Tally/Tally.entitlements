<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Both halves of one story: webcredentials lets the app use the passkeys made on
	     playtally.app (and vice versa); applinks opens pool links in the app. The domain has to
	     name this app back in /.well-known/apple-app-site-association (worker/apple.ts). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:playtally.app</string>
		<string>applinks:playtally.app</string>
	</array>
	<!-- Push notifications. "development" is what a build signed by Xcode needs; Xcode rewrites it
	     to "production" when the app is archived for TestFlight or the App Store, so this value is
	     correct in the repository and correct in a release. Adding this capability is also what
	     tells Xcode to enable Push Notifications on the App ID when it provisions, which is why
	     there is nothing to do in the developer portal beyond minting the key itself. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- The container the widgets read their snapshot out of. A widget process gets woken for a
	     fraction of a second with no session and no guarantee of a network, so the app leaves it
	     the week already worked out; this is the shelf it leaves it on. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.playtally.ios</string>
	</array>
	<!-- One Keychain item, shared, so a widget can refresh on its own timeline instead of showing
	     whatever the app last saw. Deliberately a *second* item rather than the app's own session
	     moved into the group: a Keychain lookup is scoped by access group, so re-homing the
	     existing one would hide it from the app that wrote it and sign every install out. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)app.playtally.shared</string>
	</array>
</dict>
</plist>
